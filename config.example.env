# Copiá este archivo a .env (está en .gitignore) y completá tus rutas.
# Cargalo antes de correr los scripts, por ejemplo en PowerShell:
#   Get-Content .env | ? { $_ -match '^\s*[^#].*=' } | % { $k, $v = $_ -split '=', 2; Set-Item "env:$k" $v }

# Carpeta del video con la que trabajan los renders de ejemplos/ (01_main, 10_work, 11_exports, 12_project)
ZK_PROYECTO=C:/ruta/a/mi_video
# Toma de OBS SIN extensión (OBS deja «<toma>.mp4» y una ISO por cámara: «<toma> CAM-<nombre>.mp4»)
ZK_TOMA=C:/ruta/a/grabaciones/2026-01-01 00-00-00

# Estudio: carpeta de OBS (solo se lee) y dónde se crean los proyectos
ZK_GRABACIONES=C:/ruta/a/grabaciones_obs
ZK_VIDEOS=C:/ruta/a/videos
# ZK_WHISPER=large-v3

# Logo, outro y música del canal (no van al repo). El estudio busca en ZK_ASSETS: logo_intro_3s.mp4, outro.mp4, musica.wav
ZK_ASSETS=C:/ruta/a/assets
ZK_LOGO=C:/ruta/a/assets/logo_intro_3s.mp4
ZK_OUTRO=C:/ruta/a/assets/outro.mp4
ZK_MUSICA=C:/ruta/a/assets/musica.wav
# Nombre del canal en la firma y el cierre de los Shorts
ZK_CANAL=mi canal

# Tipografías
ZK_FUENTE=C:/Windows/Fonts/bahnschrift.ttf
ZK_FUENTES_DIR=C:/ruta/a/fonts

# Material para graficos/gfx.py
ZK_FOTOS=C:/ruta/a/mi_video/06_material_usuario
ZK_CLIPS=C:/ruta/a/mi_video/06_material_usuario/broll_oficial
ZK_RECORTES=C:/ruta/a/mi_video/02_broll/cut
ZK_GFX_OUT=C:/ruta/a/mi_video/10_work/gfx

# Pista de audio que transcribe edl/transcribir_gpu.py (0 = la primera)
ZK_PISTA=4

# Solo los usan los ejemplos de fizz_pro; el resto llama a «ffmpeg» del PATH
# ZK_FFMPEG=C:/ruta/a/ffmpeg/bin/ffmpeg.exe
# ZK_FFMPEG_DIR=C:/ruta/a/ffmpeg/bin

# vedit/
# VEDIT_PROJECT=C:/ruta/a/mi_video
# VEDIT_FFMPEG=ffmpeg
# VEDIT_FFPROBE=ffprobe
# VEDIT_FONT=C:/Windows/Fonts/segoeuib.ttf
